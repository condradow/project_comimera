@using MudBlazor
<MudPaper class="pa-4" Outlined>
    <MudGrid>
        <MudItem xs="12">
            <MudText Typo="Typo.h6">Unterrichtsorganisation bei Abwesenheit der Klasse (Klasse abwesend ohne Lehrkraft)</MudText>
        </MudItem>
        <MudItem xs="12">
            <MudCheckBox @bind-Checked="Model.InfoToPersonel" T="Boolean">
                Info an freigesetzte Lehrkräfte (per Email oder persönlich durch Klassenlehrer*in)
            </MudCheckBox>
        </MudItem>
        <MudItem xs="2">
            <MudCheckBox T="Boolean" @bind-checked=""></MudCheckBox>
        </MudItem>
        <MudItem xs="10">
            <MudStack Row>
                <MudTextField @bind-Value="Model.AffectedClassOrPart" Label="Klasse/Klassenteil"></MudTextField>
                <MudTextField @bind-Value="Model.AffectedReasoning" Label="Grund(z.B. Prüfung, ÜLU)"></MudTextField>
            </MudStack>
        </MudItem>
        <MudItem xs="4" md="2">
            <MudText>Beginn der Abwesenheit:</MudText>
        </MudItem>
        <MudItem xs="4" md="2">
            <MudDatePicker Label="Datum" @bind-Date="BeginDate" />
        </MudItem>
        <MudItem xs="4" md="2">
            <MudTimePicker Label="Uhrzeit" @bind-Time="BeginTime" />
        </MudItem>
        <MudItem xs="4" md="2">
            <MudText>Ende der Abwesenheit:</MudText>
        </MudItem>
        <MudItem xs="4" md="2">
            <MudDatePicker Label="Datum" @bind-Date="EndDate" />
        </MudItem>
        <MudItem xs="4" md="2">
            <MudTimePicker Label="Uhrzeit" @bind-Time="EndTime" />
        </MudItem>
    </MudGrid>
</MudPaper>


