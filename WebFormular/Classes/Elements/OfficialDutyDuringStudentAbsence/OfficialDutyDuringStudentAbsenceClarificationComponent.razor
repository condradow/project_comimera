@using MudBlazor
@using SigPad
@using WebFormular.Components.UI

<MudGrid>
    <MudItem xs="2">
        <MudDatePicker @bind-Date="model.Date" IconSize="Size.Small" Label="am" Variant="Variant.Text" />
    </MudItem>
    <MudItem xs="2">
        <MudNumericField T="int?" @bind-Value="model.TeachingPeriod" Label="U-Std" Variant="Variant.Text" Min="1" />
    </MudItem>
    <MudItem xs="4">
        <MudTextField @bind-Value="model.OtherOfficialDuty"Label="Anderweitige dienstliche Tätigkeit"Variant="Variant.Outlined"FullWidth />
    </MudItem>
    <MudItem xs="2">
        <SingatureComponent @bind-Signature="model.SignatureTeacher" />
    </MudItem>
    <MudItem xs="2">
        <SingatureComponent @bind-Signature="model.SignatureDepartmentHead" />
    </MudItem>
</MudGrid>
@code {
    [Parameter, EditorRequired]
    public OfficialDutyDuringStudentAbsenceClarification model { get; set; }

   
}
