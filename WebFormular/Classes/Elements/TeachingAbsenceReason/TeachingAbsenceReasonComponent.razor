
@using MudBlazor

<MudPaper Class="pa-4" Outlined="true">

    <MudText Typo="Typo.h6" Class="mb-4">
        @Model.Title
    </MudText>

    <MudGrid>

        <MudItem xs="12" md="6">
            <MudDatePicker Label="Beginn der Abwesenheit"
                           @bind-Date="BeginDate" />
        </MudItem>

        <MudItem xs="12" md="6">
            <MudDatePicker Label="Ende der Abwesenheit"
                           @bind-Date="EndDate" />
        </MudItem>

        <MudItem xs="12">
            <MudCheckBox @bind-Value="Model.MaterialOnTeachingPlatform"
                         Label="Material auf Teaching Platform" />

            <MudCheckBox @bind-Value="Model.MaterialOnLearningPlatform"
                         Label="Material auf Learning Platform" />

            <MudCheckBox @bind-Value="Model.MaterialOnMail"
                         Label="Material per Mail" />
        </MudItem>

    </MudGrid>

</MudPaper>

@code {

    [Parameter, EditorRequired]
    public TeachingAbsenceReason Model { get; set; } = null!;

    private DateTime? BeginDate
    {
        get => Model.BeginAbsence;
        set
        {
            if (value.HasValue)
                Model.BeginAbsence = value.Value;
        }
    }

    private DateTime? EndDate
    {
        get => Model.EndAbsence;
        set
        {
            if (value.HasValue)
                Model.EndAbsence = value.Value;
        }
    }
}