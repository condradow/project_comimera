@using MudBlazor

<MudPaper Class="pa-4" Elevation="0">
   
    <MudGrid >
        <MudItem xs="12">
            <MudText Typo="Typo.h6">Unterrichtsorganisation bei Abwesenheit der Lehrkraft</MudText>
        </MudItem>
        <MudItem xs="12">
            <MudText>Ich bin <b>aus dem folgenden Grund</b> verhindert, meinen planmäßigen Unterricht durchzuführen:</MudText>
        </MudItem>
        <MudItem xs="12">
            <MudText Typo="Typo.caption">(Bitte eventuell Anordnung des Dienstgeschäftes bzw. Einladungsschreiben als Kopie beifügen)</MudText>
        </MudItem>
        <MudItem xs="4"  class="justify-center align-center d-flex">
            <MudText  Align="Align.Center" >Beginn der Abwesenheit</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudDatePicker Label="Datum" @bind-Date="BeginDate" />

        </MudItem>
        <MudItem xs="4">
            <MudTimePicker Label="Uhrzeit" @bind-Time="BeginTime" />

        </MudItem>

        <MudItem xs="4" class="justify-center align-center d-flex">
            <MudText Align="Align.Center">Ende der Abwesenheit</MudText>
        </MudItem>
        <MudItem xs="4">
            <MudDatePicker Label="Datum" @bind-Date="EndDate" />

        </MudItem>
        <MudItem xs="4">
            <MudTimePicker Label="Uhrzeit" @bind-Time="EndTime" />

        </MudItem>
   
        
        <MudItem xs="4">
            <MudCheckBox @bind-Value="Model.MaterialOnTeachingPlatform" Label="auf Lernplattform" />
        </MudItem>
        <MudItem xs="4">
            <MudCheckBox @bind-Value="Model.MaterialOnDemand" Label="nach Absprache" />
        </MudItem>
        <MudItem xs="4">
            <MudCheckBox @bind-Value="Model.MaterialOnMail" Label="per Mail" />
        </MudItem>
    </MudGrid>
</MudPaper>

