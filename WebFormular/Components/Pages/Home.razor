@page "/"
<MudGrid class=" pa-4">
    <MudItem xs="6" class="fade-in">
        <MudPaper Height="30vh" Outlined="true" Elevation="0" Style="display: flex;">
            <MudButton Href="document-overview-personal" FullWidth="true" Style="height: 100%;" Color="Color.Transparent" Variant="Variant.Text" DropShadow="false">
                <MudStack AlignItems="AlignItems.Start" Spacing="0">
                    <MudText>Meine Anträge</MudText>
                    <MudDivider class="pt-2"></MudDivider>
                    <MudBadge Content="10" Color="Color.Success" Origin="Origin.CenterRight">
                        <MudText class="pr-4" Typo="Typo.caption">Genehmingt</MudText>
                    </MudBadge>
                    <MudBadge Content="3" Color="Color.Error" Origin="Origin.CenterRight">
                        <MudText class="pr-4" Typo="Typo.caption">Offen</MudText>
                    </MudBadge>
                    <MudBadge Content="3"  Origin="Origin.CenterRight">
                        <MudText class="pr-4" Typo="Typo.caption">Entwürfe</MudText>
                    </MudBadge>
                </MudStack>
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" class="fade-in">
        <MudPaper Height="30vh" Outlined="true" Elevation="0" Style="display: flex;">
            <MudButton Href="document-overview-pending" FullWidth="true" Style="height: 100%;" Color="Color.Transparent" Variant="Variant.Text" DropShadow="false">
                <MudBadge Content="3" Color="Color.Error">
                    <MudText>Zu Prüfen</MudText>
                </MudBadge>
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" class="fade-in">
        <MudPaper Height="30vh" Outlined="true" Elevation="0" Style="display: flex;">
            <MudButton Href="document-overview" FullWidth="true" Style="height: 100%;" Color="Color.Transparent" Variant="Variant.Text" DropShadow="false">
                <MudText> Alle Anträge</MudText>
            </MudButton>
        </MudPaper>
    </MudItem>
    <MudItem xs="6" class="fade-in">
        <MudPaper Height="30vh" Outlined="true" Elevation="0" Style="display: flex;">
            <MudButton FullWidth="true" Style="height: 100%;" Color="Color.Transparent" Variant="Variant.Text" DropShadow="false">
                <MudText> Gesamte Historie</MudText>
            </MudButton>
        </MudPaper>
    </MudItem>
</MudGrid>